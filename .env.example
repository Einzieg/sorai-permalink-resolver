# Server
# If PORT is busy, the server will try the next port unless SPR_STRICT_PORT=1.
PORT=3131

# Bind host (default 127.0.0.1). For Docker / remote access, uncomment:
# HOST=0.0.0.0

# Optional: protect the web UI + /api/* with an access key.
# If set, you must enter this key when opening the site.
SPR_AUTH_KEY=YOUR_SITE_KEY_HERE

# Custom parse server (used by /api/resolve)
SORAI_PARSE_URL=https://api.parse.com
SORAI_PARSE_TOKEN=YOUR_PARSE_TOKEN_HERE

# UI defaults (optional)
SPR_DEFAULT_MODE=proxy

# If 1, the web UI will treat parse server/token as server-side only (recommended).
SPR_LOCK_CONFIG=1

# If 1, do NOT auto-fallback when PORT is in use.
SPR_STRICT_PORT=1

# Media info (optional)
# /api/media-info only allows these hostnames by default (SSRF guard).
# SPR_MEDIA_ALLOW_HOSTS=videos.openai.com
#
# Max bytes for temp download (0 = unlimited, not recommended)
# SPR_MEDIA_MAX_BYTES=536870912
#
# Temp dir for downloads (defaults to OS temp)
# SPR_MEDIA_TMP_DIR=/tmp
#
# Keep temp downloads for debugging (0/1)
# SPR_MEDIA_TMP_KEEP=0
#
# If ffprobe isn't in PATH, point to it:
# SPR_FFPROBE_PATH=/usr/bin/ffprobe

# If exiftool isn't in PATH, point to it:
# SPR_EXIFTOOL_PATH=/usr/bin/exiftool
